PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-local-secret
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot
# Optional comma-separated DNS resolver IPs for MongoDB SRV lookups (e.g. 1.1.1.1,8.8.8.8).
MONGODB_DNS_SERVERS=

# Select one: none, gemini, groq, ollama (for general AI features)
AI_PROVIDER=gemini
# Optional. Defaults are provider-specific.
AI_MODEL=gemini-3.5-flash
# Rejection Coach overrides. Empty values fall back to AI_MODEL and its provider default.
AI_LITE_MODEL=
AI_STRONG_MODEL=

# Add a provider key only to server/.env, never to client files or browser storage.
# Gemini and Groq use this server-side key variable.
AI_API_KEY=
# Company research uses Tavily for current public search and Groq to analyze the results.
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_COMPANY_MODEL=openai/gpt-oss-120b
# Local Ollama defaults to http://localhost:11434 and normally needs no key.
# For Ollama Cloud or another protected endpoint, set its URL and server-side key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Job discovery ingestion. Keep all credentials in this server-only file.
THEIRSTACK_API_KEY=
# JSON array. Add only company boards you are authorized to index.
JOB_COMPANIES_JSON=[]
# Pipe-separated TheirStack title searches. Empty uses the built-in technical-role set.
JOB_SEARCH_TITLES=
# Optional country-code filter. Empty searches globally; India is prioritized in result ordering.
JOB_SEARCH_COUNTRIES=
JOB_SYNC_INTERVAL_MINUTES=360
JOB_SYNC_MAX_PAGES=20
THEIRSTACK_PAGE_SIZE=50
THEIRSTACK_MAX_PAGES=2
THEIRSTACK_INITIAL_LOOKBACK_DAYS=90
LEVER_PAGE_SIZE=100
JOB_PROVIDER_TIMEOUT_MS=25000
JOB_VERIFICATION_STALE_DAYS=7
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_RETRY_INTERVAL_MS=15000
# Required only for POST /api/admin/jobs/sync.
JOB_SYNC_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in
ADZUNA_PAGE_SIZE=20
ADZUNA_MAX_PAGES=2
ADZUNA_MAX_DAYS_OLD=30
