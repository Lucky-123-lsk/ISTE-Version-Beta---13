{
  "manifest_version": 3,
  "name": "CareerPilot Assisted Applications",
  "version": "0.1.0",
  "description": "Candidate-controlled, review-only autofill for supported job application forms.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:4000/*"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://*.greenhouse.io/*", "https://boards.greenhouse.io/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
