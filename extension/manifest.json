{
  "manifest_version": 3,
  "name": "CareerPilot AI - Application Helper",
  "version": "0.1.0",
  "description": "Candidate-controlled profile filling on employer application pages.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:4000/*", "http://127.0.0.1:4000/*"],
  "action": {
    "default_title": "CareerPilot AI",
    "default_popup": "popup.html"
  }
}
